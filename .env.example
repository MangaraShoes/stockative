# Copie este arquivo pra .env e preencha os valores reais. .env nunca é
# commitado (ver .gitignore) — cada ambiente (seu Mac, produção) tem o seu.

# Shopify — gerado automaticamente por `shopify app dev` / `shopify app config link`
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_orders
HOST=

# Banco de dados — Postgres (ver migração de 13/09/2026, antes era SQLite
# local). Um provedor free serve: Neon, Render Postgres, Supabase.
# DATABASE_URL usa o pooler (bom pro app em runtime); DIRECT_URL é a conexão
# direta que o Prisma precisa pra rodar migrations (ver prisma/schema.prisma).
# No Neon, sem pooler, as duas podem apontar pra mesma connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Segredo compartilhado pelos endpoints /cron/* (ver app/routes/cron.*.tsx e
# .github/workflows/cron-jobs.yml) — gerar com: openssl rand -hex 32
CRON_SECRET=

# IA (OpenRouter) — geração de copy, brand voice, content pillars, imagens
OPENROUTER_API_KEY=

# Meta — conexão de Instagram/Facebook
META_APP_ID=
META_APP_SECRET=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# TikTok — conexão + upload de Reel pra caixa de rascunhos (Content Posting
# API em modo "inbox", sem a auditoria de Direct Post — ver
# app/services/tiktok/publish.server.ts). Chaves vêm de developers.tiktok.com
# → Manage apps → app do Stockative → Credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube — conexão + upload de Shorts (videos.insert, uploadType=multipart,
# publica direto e público — sem etapa de rascunho como o TikTok). Chaves
# vêm do Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client IDs (tipo "Web application", com o redirect URI de
# auth.youtube.callback.tsx cadastrado em "Authorized redirect URIs").
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Creatify — protótipo de Reel com avatar de IA (UGC ads), avaliado em
# 14/09/2026 contra HeyGen e Arcads. Precisa de assinatura paga da API
# (plano "API Starter", $99/mês) em https://creatify.ai — depois pegar as
# chaves em Account → API Dashboard → "Show API Keys".
CREATIFY_API_ID=
CREATIFY_API_KEY=

# Opcional — domínio customizado da loja, quando usado em algum fluxo
SHOP_CUSTOM_DOMAIN=
