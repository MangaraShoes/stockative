# HTTPS automático (Let's Encrypt): o Caddy emite e renova o certificado
# sozinho assim que o DNS do domínio aponta pro IP do servidor.
app.stockative.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# App público (PUBLIC-APP.md) — descomentar quando o DNS de
# apps.stockative.com apontar pra cá e o serviço app-public estiver ligado.
# apps.stockative.com {
# 	encode zstd gzip
# 	reverse_proxy 127.0.0.1:3001
# }
