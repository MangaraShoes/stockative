# HTTPS automático (Let's Encrypt): o Caddy emite e renova o certificado
# sozinho assim que o DNS do domínio aponta pro IP do servidor.
app.stockative.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# App público (PUBLIC-APP.md), serviço app-public na porta 3001. Precisa do
# DNS de apps.stockative.com apontando pra cá antes de subir, senão o Caddy
# fica tentando emitir o certificado sem conseguir.
apps.stockative.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}
