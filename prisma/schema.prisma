// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  // DATABASE_URL usa o pooler do Neon (bom pro app em runtime); DIRECT_URL é
  // a conexão direta, sem pooler — o Prisma Migrate precisa dela porque uma
  // conexão via pgbouncer/pooler não sustenta os advisory locks que uma
  // migração usa.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Gerenciado automaticamente pelo pacote @shopify/shopify-app-react-router — não editar.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A partir daqui: modelo de dados do produto (ver ARCHITECTURE.md).
// Campos documentados lá como "enum" (ex.: status [draft|scheduled|...]) viram
// String aqui — SQLite não tem tipo enum nativo, essa validação fica por conta
// do código da aplicação (TypeScript/Zod), não do banco.

model Shop {
  id            String    @id @default(cuid())
  shopifyDomain String    @unique
  accessToken   String
  // "basic" | "grow" | "plus" | "custom" (Patricia, 24/09/2026: 4 planos
  // com cadência/mix de formato fixos por plano, exceto "custom" — ver
  // customPostsPerMonth/customReelsPerMonth e planTiers.server.ts). Campo
  // já existia como "starter" mas nunca foi lido em lugar nenhum do código
  // até agora — reaproveitado em vez de criar um novo.
  plan          String    @default("basic")
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  // Só usados quando plan = "custom" (Patricia, 24/09/2026: "a pessoa
  // escolhe o numero de reels ou postas mensal e vamos gerar um valor de
  // acordo") — null pra qualquer outro plano, e também null até a lojista
  // configurar o custom pela primeira vez (cai no default do "basic" nesse
  // meio-tempo, nunca trava a geração automática).
  customPostsPerMonth Int?
  customReelsPerMonth Int?

  // Preferência de ESTILO de imagem, capturada uma vez no onboarding
  // (Patricia, 24/09/2026: "podemos tbem perguntar que tipo de imagem a
  // pessoa deseja... para ja começarmos a criar de forma asseritva...sem
  // precisar regenerar tantas vezes") — "lifestyle" | "still" | "held" |
  // "studio", ou null (= deixa a IA decidir por objetivo comercial, o
  // comportamento de sempre, ver MODE_PREFERENCE_BY_OBJECTIVE em
  // visualMode.server.ts). Nunca obrigatório preencher.
  imageStylePreference String?

  // Brand Intelligence (Camada 1) — onboarding curto por questionário, ver
  // CLAUDE.md. Ainda não tem análise automática de site/logo (Phase 2).
  brandDescription String? // quem é a marca, em poucas frases
  brandTone        String? // tom de voz, ex.: "warm, confident, never pushy"
  brandAvoid       String? // palavras/tom que a marca nunca deve usar

  // Trava a aprovação do store voice até a lojista confirmar o idioma de
  // publicação pelo menos uma vez (mesmo que aceite o padrão em inglês) —
  // Patricia, 12/09/2026: "precisa ser passo obrigatório salvar a
  // linguagem [antes de] aprovar o brand voice". Setado só quando a action
  // "save-language" roda, nunca fica true pelo valor padrão sozinho.
  languageConfirmed Boolean @default(false)

  // Passo obrigatório do onboarding (Patricia, 12/09/2026: "step 3", antes
  // da store voice) — a lojista pode optar por não informar concorrentes,
  // mas precisa passar pela decisão; ver onboardingStatus.server.ts.
  competitorsSkipped Boolean @default(false)

  // Logo opcional (data URI, fundo já tratado pra ficar transparente quando
  // possível — ver logoOverlay.server.ts). applyLogoOverlay é opt-in: a
  // lojista decide se quer o logo aplicado no canto das imagens geradas.
  logoUrl          String?
  applyLogoOverlay Boolean @default(false)

  // Fuso horário real da loja (IANA, ex.: "America/Sao_Paulo",
  // "Europe/Brussels"), buscado uma vez da Admin API (shop.ianaTimezone) e
  // cacheado aqui — Patricia, 12/09/2026: "precisamos considerar sim o fuso
  // horario da loja queremos vender este app no brasil e Europa
  // principalmente". Usado pra agendar os posts da semana no horário local
  // de verdade da lojista, não no fuso do servidor. Null só antes da
  // primeira visita ao app depois de instalado (ver ensureShopTimezone).
  ianaTimezone String?

  // Marca a última vez que um plano semanal foi gerado automaticamente
  // (ver generateDueWeeklyPlans em planWeek.server.ts) — achado de revisão
  // externa, 12/09/2026: "there is also a distinction between publishing
  // an existing plan automatically and creating the next plan
  // automatically... no recurring weekly-plan generation path". Null pra
  // loja que nunca teve um plano gerado (nem manual nem automático).
  lastWeeklyPlanGeneratedAt DateTime?

  // Trava de concorrência pra planWeeklyContent (ver planWeek.server.ts) —
  // sem isso, um clique duplo no botão "Generate"/"Regenerate" antes de ele
  // desabilitar, ou o cron diário rodando bem na hora que a lojista clica,
  // criavam DOIS weekBatchId diferentes disputando a mesma semana (achado
  // de revisão de código, 13/09/2026). Null quando nenhuma geração está em
  // andamento; tratada como expirada depois de 15 minutos pra nunca travar
  // a loja pra sempre se o processo cair no meio.
  weeklyPlanGeneratingAt DateTime?

  // Idioma(s) de publicação (Patricia, 10/09/2026: "a cliente escolhe o
  // idioma... até 2 idiomas, aparece o primeiro e na sequência o segundo,
  // em todos os posts") — contentLanguagePrimary sempre presente (default
  // inglês pra loja que ainda não configurou), Secondary é opcional. Quando
  // os dois estão setados, todo post publica com a legenda completa no
  // idioma principal seguida da legenda completa traduzida no secundário,
  // no mesmo post — mesmo padrão que a Mangará já usa de verdade no
  // Instagram (FR seguido de NL).
  contentLanguagePrimary   String  @default("en")
  contentLanguageSecondary String?

  socialAccounts       SocialAccount[]
  products             ProductCache[]
  contentItems         ContentItem[]
  creativeAssets       CreativeAsset[]
  imageCreditPurchases ImageCreditPurchase[]
  competitorAccounts   CompetitorAccount[]
  contentPillars       ContentPillar[]
  pinterestBoards      PinterestBoard[]
  promotions           Promotion[]
}

// Promoção real declarada pela lojista (Patricia, 13/09/2026: "poderiamos...
// criar conteudo sazonal ou de campanhas promocionais ex blackfriday...
// escolher a categoria ou a loja todo... criamos as campanhas em cima de
// reais necessidades") — é a evidência real que faltava pra legitimar o
// arquétipo Urgency (MARKETING-KNOWLEDGE.md seção 4: "Se a intenção
// comercial for de fato escoar estoque, a ação correta é o lojista criar
// uma promoção real, com prazo"). Uma promoção ATIVA substitui o plano
// semanal normal inteiro (ver planPromotionalWeek em planWeek.server.ts),
// nunca soma aos posts comuns — decisão da Patricia, 13/09/2026.
model Promotion {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  name        String // "Black Friday", "Christmas", ou texto livre
  discountPct Float
  scopeType   String // "store" | "collection" | "products"
  scopeValue  String? // nome da coleção Shopify quando "collection" (Patricia, 13/09/2026: "assim ele pode criar uma collection com os items que deseja promover sem ter que criar uma nova categoria"); IDs de ProductCache separados por vírgula quando "products"; null quando "store"
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())

  contentItems ContentItem[]

  @@index([shopId])
}

// Fase 1 do "sistema de crescimento" (ver MARKETING-KNOWLEDGE.md) — 4 a 6
// pilares de conteúdo específicos da marca (nunca genéricos tipo "educação"),
// gerados por IA a partir do diagnóstico + catálogo, aprovados/editados pela
// lojista, mesmo padrão do Brand Voice (rascunho, nunca autossalvo).
model ContentPillar {
  id                String   @id @default(cuid())
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id])
  name              String
  function          String
  attractsAudience  String
  problemExplored   String
  promise           String
  idealFormat       String // carousel | single_image | reel
  cta               String
  growthCategory    String // atração | autoridade | relacionamento | conversão
  targetSharePct    Float // percentual ideal da distribuição semanal
  drivesReach       Boolean @default(false)
  drivesFollowers   Boolean @default(false)
  drivesPurchase    Boolean @default(false)
  postLess          Boolean @default(false) // sinaliza pilar que merece frequência menor
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contentItems ContentItem[]

  @@index([shopId])
}

model SocialAccount {
  id                  String    @id @default(cuid())
  shopId              String
  shop                Shop      @relation(fields: [shopId], references: [id])
  platform            String // instagram | facebook | pinterest | tiktok
  accessToken         String
  expiresAt           DateTime?
  igBusinessAccountId String?
  fbPageId            String?
  refreshToken        String?
  pinterestUserId     String?
  pinterestUsername   String?
  tiktokOpenId        String? // identificador estável da conta TikTok (não muda, diferente do username)
  tiktokUsername      String?

  @@unique([shopId, platform])
  @@index([shopId])
}

model PinterestBoard {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id])
  category       String // matches ProductCache.productType, used to route new pins
  pinterestBoardId String
  name           String
  createdAt      DateTime @default(now())

  @@unique([shopId, category])
  @@index([shopId])
}

model ProductCache {
  id                String    @id @default(cuid())
  shopId            String
  shop              Shop      @relation(fields: [shopId], references: [id])
  shopifyProductId  String
  shopifyVariantId  String? // nullable — decisão de conteúdo opera por padrão no nível de produto
  title             String
  description       String?
  price             Float
  compareAtPrice    Float?
  // Custo por unidade (Settings > Products > Cost per item na Shopify) —
  // null quando a lojista nunca preencheu esse campo. Único jeito real de
  // saber MARGEM, não só preço de tabela — sem isso, o Product Opportunity
  // Score podia priorizar estoque parado de margem baixa acima de um
  // best-seller de margem alta (achado da análise estratégica, 14/09/2026).
  // Confirmado ao vivo, 14/09/2026: InventoryItem.unitCost já vem com o
  // escopo read_products existente, sem precisar pedir escopo novo.
  unitCost          Float?
  inventoryQuantity Int       @default(0)
  productType       String?
  tags              String? // lista separada por vírgula
  collections       String? // lista separada por vírgula
  imageUrl          String?
  productUrl        String? // URL pública da loja — usada como link de volta no Pin do Pinterest
  status            String // active | draft | archived
  shopifyCreatedAt  DateTime?
  updatedAt         DateTime  @updatedAt

  // Classificação de "como fotografar este produto" pra geração de imagem
  // por IA — calculada uma vez por IA barata e guardada aqui, não recalculada
  // a cada geração (custo real de mais uma chamada por imagem, sem
  // necessidade: o tipo de foto certo pra um produto não muda entre uma
  // geração e outra). Null até a primeira geração de imagem pedir isso (ver
  // productClassification.server.ts). Existe pra abrir a Stockative pra
  // qualquer tipo de loja Shopify, não só calçado/vestuário (Patricia,
  // 14/09/2026: "queremos vender o app para todo o tipo de loja").
  //
  // Interação e modo visual são dimensões DIFERENTES (Patricia, 14/09/2026,
  // revisando a proposta: "held descreve como alguém interage com o
  // produto; Editorial descreve a abordagem criativa... uma imagem pode ser
  // editorial com o produto na mão ou sozinho"). Um produto pode admitir
  // MAIS DE UMA interação válida (um perfume: standalone E held) — a
  // campanha (objetivo comercial) escolhe entre elas na hora de gerar, não
  // uma classificação fixa por produto. Lista separada por vírgula.
  imagingInteractions String? // worn,held,applied,standalone — ver ProductInteraction
  imagingCategory     String? // footwear | apparel | jewelry | home_decor | etc. — ver VisualCategory

  commerceSignal CommerceSignal?
  contentItems   ContentItem[]
  creativeAssets CreativeAsset[]
  images         ProductImage[]

  @@unique([shopId, shopifyProductId])
  @@index([shopId])
}

// Galeria completa do produto na Shopify (não só a featured image que
// products_cache.imageUrl guarda). Toda ProductImage é sempre "still" —
// nunca geramos still por IA (decisão de Patricia, 09/09/2026, mesma regra
// já usada no projeto da Mangará): a única fonte de imagem "editorial" é o
// CreativeAsset gerado (ver ContentItemImage), então não precisa de
// classificação por IA aqui.
model ProductImage {
  id             String   @id @default(cuid())
  productId      String
  product        ProductCache @relation(fields: [productId], references: [id])
  shopifyImageId String
  url            String
  position       Int // ordem na galeria da Shopify (1 = primeira)
  createdAt      DateTime @default(now())

  contentItemImages ContentItemImage[]

  @@unique([productId, shopifyImageId])
  @@index([productId])
}

// Materializado por job periódico — nunca calculado on-the-fly a cada decisão
// do Decision Engine (estouraria rate limit da Admin API num catálogo grande).
model CommerceSignal {
  id                String       @id @default(cuid())
  productId         String       @unique
  product           ProductCache @relation(fields: [productId], references: [id])
  unitsSold7d       Int          @default(0)
  unitsSold30d      Int          @default(0)
  revenue30d        Float        @default(0)
  salesVelocity     Float        @default(0)
  daysSinceLastSale Int?
  inventoryAgeDays  Int?
  margin            Float? // nullable no MVP — Shopify não expõe custo de forma uniforme
  computedAt        DateTime     @default(now())
}

model ContentItem {
  id                  String        @id @default(cuid())
  shopId              String
  shop                Shop          @relation(fields: [shopId], references: [id])
  productId           String?
  product             ProductCache? @relation(fields: [productId], references: [id])
  contentPillarId     String? // qual pilar (Fase 1) orientou este post, se houver — ver planWeek.server.ts
  contentPillar       ContentPillar? @relation(fields: [contentPillarId], references: [id])
  // Promoção real que gerou este post, se houver (ver planPromotionalWeek em
  // planWeek.server.ts) — usado pra travar a publicação depois do prazo
  // (Patricia, 13/09/2026: "sim trava a publicação depois do prazo").
  promotionId         String?
  promotion           Promotion? @relation(fields: [promotionId], references: [id])
  platform            String // instagram | facebook
  format              String        @default("post") // post | reel — reel monta um MP4 a partir das imagens já geradas e aprovadas (ver buildReel.server.ts), nunca gera vídeo novo por IA
  commercialObjective String // awareness | engagement | traffic | conversion | inventory
  decisionBrief       Json? // saída estruturada do Estágio 1 (arquétipo, ângulo, framework, etc.)
  captionText         String?
  hashtags            String?
  cta                 String?
  creativeAssetId     String?
  creativeAsset       CreativeAsset? @relation(fields: [creativeAssetId], references: [id])
  status              String        @default("draft") // draft | approved | publishing | partial | published | failed | cancelled
  // Agrupa os posts criados juntos por um "Generate this week's plan" (ver
  // planWeek.server.ts) — a tela do plano semanal usa isso pra reabrir
  // mostrando o mesmo lote depois de um refresh, e pra CANCELAR o lote
  // anterior (ainda não publicado) em vez de deixar dois lotes concorrendo
  // pela mesma janela de publicação (achado de revisão, 12/09/2026: "Once
  // the scheduler runs, both batches can become eligible for publication").
  // Null pra post criado avulso em "Create content", que nunca faz parte
  // de um lote semanal.
  weekBatchId         String?
  scheduledAt         DateTime?
  publishedAt         DateTime?
  externalPostId      String?
  storyExternalPostId String? // ID do Story publicado junto (mesma imagem hero, sem legenda — API de Stories não tem campo de caption)
  facebookExternalPostId String? // ID do post espelhado na Página do Facebook (mesma imagem/carrossel + legenda do post do Instagram)
  pinterestExternalPostId String? // ID do Pin espelhado no board da categoria do produto (imagem hero + legenda)
  // publish_id do upload pra caixa de rascunhos do TikTok (Content Posting
  // API em modo inbox, sem a auditoria de Direct Post) — só existe pra
  // post format="reel"; a lojista precisa abrir o TikTok e confirmar a
  // publicação de lá, o app só entrega o vídeo pronto na caixa de entrada.
  tiktokExternalPostId String?
  // Quando a imagem hero foi subida pra galeria do produto no Shopify (ver
  // publishContentItem.server.ts). Sem isso, um retry de um item "partial"
  // (Instagram publicou, uma etapa depois falhou) subia a mesma imagem de
  // novo a cada tentativa, duplicando foto no produto (achado de revisão de
  // código, 13/09/2026).
  galleryImageUploadedAt DateTime?
  // URL no CDN do Shopify do MP4 montado pra este post (só quando format="reel").
  // videoGeneratedAt é o guarda de idempotência, mesmo padrão de galleryImageUploadedAt:
  // sem isso, um retry remontava e resubia o vídeo do zero a cada tentativa.
  videoUrl             String?
  videoGeneratedAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  trackedLink        TrackedLink?
  performanceSignals PerformanceSignal[]
  generationLogs     GenerationLog[]
  images             ContentItemImage[]

  @@index([shopId])
  @@index([status])
  @@index([weekBatchId])
}

// Sequência ordenada de imagens de um post/carrossel — position=1 é a capa
// (a imagem editorial, que nunca deve se repetir entre posts do mesmo
// produto), as seguintes são stills de apoio (podem se repetir). Cada linha
// referencia OU uma foto já existente na Shopify (productImage) OU uma
// gerada por IA (creativeAsset), nunca as duas.
model ContentItemImage {
  id              String        @id @default(cuid())
  contentItemId   String
  contentItem     ContentItem   @relation(fields: [contentItemId], references: [id])
  position        Int
  productImageId  String?
  productImage    ProductImage? @relation(fields: [productImageId], references: [id])
  creativeAssetId String?
  creativeAsset   CreativeAsset? @relation(fields: [creativeAssetId], references: [id])

  @@index([contentItemId])
  @@index([productImageId])
  @@index([creativeAssetId])
}

model TrackedLink {
  id            String      @id @default(cuid())
  contentItemId String      @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  shortCode     String      @unique
  utmParams     Json?
  clickCount    Int         @default(0)
  createdAt     DateTime    @default(now())
}

model PerformanceSignal {
  id                String      @id @default(cuid())
  contentItemId     String
  contentItem       ContentItem @relation(fields: [contentItemId], references: [id])
  platform          String
  reach             Int?
  likes             Int?
  comments          Int?
  saves             Int?
  shares            Int?
  clicks            Int?
  productPageVisits Int?
  addToCart         Int?
  orders            Int?
  revenue           Float?
  capturedAt        DateTime    @default(now())

  @@index([contentItemId])
}

model GenerationLog {
  id                     String       @id @default(cuid())
  contentItemId          String?
  contentItem            ContentItem? @relation(fields: [contentItemId], references: [id])
  taskType               String // decision_engine | creative_copy | translation | image | video
  model                  String
  tokensUsed             Int?
  costEstimate           Float?
  passedFidelityCheck    Boolean? // só relevante para taskType = image — produto bate com o original?
  passedCompositionCheck Boolean? // só relevante para taskType = image — composição é editorial, não genérica/sem graça?
  countsAsCredit         Boolean      @default(false)
  // Explicação que a lojista deu (sugestão clicada ou texto livre) do que
  // queria mudar nesta regeneração (Patricia, 24/09/2026: "cada vez que
  // ele regenerar o app aprende ele precisa explicar pq quer regenerar") —
  // null pra uma geração normal, primeira vez, sem ser regeneração de nada.
  // Existe pra virar sinal de aprendizado de verdade, não só um prompt
  // descartado depois de usado uma vez.
  regenerationReason     String?
  createdAt              DateTime     @default(now())

  // Piloto de diversidade criativa (Patricia, 12/09/2026, discussão sobre o
  // "Creative System" — ver planWeek.server.ts/repertoire.server.ts).
  // Guardado direto aqui (não só via contentItemId) pra poder consultar o
  // histórico da LOJA rápido, sem join. Só preenchido pra taskType = image.
  shopId      String?
  productId   String?
  category    String? // footwear | apparel | jewelry | etc. — ver VisualCategory
  campaignId  String? // hoje: o weekBatchId do post, quando existe; null pra post avulso

  // Registrados desde já (Patricia, 14/09/2026: "registrar agora o modo
  // visual, o objetivo e a versão da estratégia evita perder o histórico
  // necessário depois") — mesmo o learning loop visual ainda não existindo,
  // sem isso o histórico de qual modo/objetivo gerou qual resultado ficaria
  // perdido até o dia de construir esse loop.
  interaction         String? // worn | held | applied | standalone — a interação ESCOLHIDA pra esta geração, ver ProductInteraction
  visualMode          String? // product_hero | lifestyle | editorial | styled_still_life — ver VisualMode
  commercialObjective String? // objetivo do post que gerou esta imagem, ver CommercialObjective
  strategyVersion     String? // versão da arquitetura de decisão visual em vigor nesta geração
  // Preservar/evitar explícitos usados nesta geração (ver
  // fidelityConstraints.server.ts) — checagem de IA AJUDA a avaliar
  // fidelidade, não a garante; isto é o que foi de fato pedido/checado,
  // pra auditoria futura.
  fidelityConstraints Json?

  // Solicitado: o que o repertório escolheu ANTES de montar o prompt.
  requestedAction      String?
  requestedEnvironment String?
  requestedFraming     String?
  requestedLight       String?

  // Observado: o que a checagem de composição classificou DEPOIS de olhar
  // a imagem de verdade — "unknown"/"not_applicable" são respostas válidas,
  // nunca inventadas. Comparar isso com o solicitado é o que expõe quais
  // instruções o gerador de fato obedece.
  observedAction      String?
  observedEnvironment String?
  observedFraming     String?
  observedLight       String?

  creativeAsset CreativeAsset?

  @@index([contentItemId])
  @@index([shopId])
}

model CreativeAsset {
  id              String         @id @default(cuid())
  shopId          String
  shop            Shop           @relation(fields: [shopId], references: [id])
  productId       String?
  product         ProductCache?  @relation(fields: [productId], references: [id])
  imageUrl        String
  source          String // shopify_existing | ai_generated
  generationLogId String?        @unique
  generationLog   GenerationLog? @relation(fields: [generationLogId], references: [id])
  createdAt       DateTime       @default(now())

  contentItems      ContentItem[]
  contentItemImages ContentItemImage[]

  @@index([shopId])
}

model ImageCreditPurchase {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id])
  creditsPurchased Int
  pricePaid        Float
  purchasedAt      DateTime @default(now())

  @@index([shopId])
}

model CompetitorAccount {
  id                String   @id @default(cuid())
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id])
  instagramUsername String
  addedAt           DateTime @default(now())

  // true só quando o Business Discovery confirmou a conta de verdade (ok:
  // true) — hoje isso quase nunca acontece pra conta de terceiro porque a
  // Meta ainda não aprovou Advanced Access pro app (ver
  // businessDiscovery.server.ts), então a maioria fica false até essa
  // aprovação sair. Nunca mostrar como validado sem isso (Patricia,
  // 12/09/2026: "eu coloquei um IG que nem existe e ele deu ok").
  verified Boolean @default(false)

  // Bio e site, buscados junto no Business Discovery quando a chamada
  // funciona — mais úteis pra confirmar que é a conta certa do que
  // seguidores/posts (Patricia, 12/09/2026: "acho mais importante mencionar
  // a frase principal e o website"). Ficam null enquanto a Meta não aprova
  // o acesso, igual verified.
  biography String?
  website   String?

  posts CompetitorPost[]

  @@index([shopId])
}

// Sincronizado periodicamente via Instagram Graph API (Business Discovery) —
// só dados públicos (likes/comentários/legenda), nunca reach/conversão.
model CompetitorPost {
  id                  String            @id @default(cuid())
  competitorAccountId String
  competitorAccount   CompetitorAccount @relation(fields: [competitorAccountId], references: [id])
  igMediaId           String
  caption             String?
  mediaType           String?
  likeCount           Int?
  commentCount        Int?
  postedAt            DateTime?
  permalink           String?
  syncedAt            DateTime          @default(now())

  @@index([competitorAccountId])
}
