{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "**",
      "!**/*.md",
      "!.github/**",
      "!.codex/**",
      "!.artifacts/**"
    ]
  },
  "deploy": {
    "drainingSeconds": 300
  }
}
